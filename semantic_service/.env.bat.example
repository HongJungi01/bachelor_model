@echo off
rem Copy this file to .env.bat and fill in ONE provider's API key.
rem Default provider is Gemini. To use Claude, set LLM_PROVIDER=anthropic.

rem -- Gemini (default) -----------------------------------------------------
rem Get a key at https://aistudio.google.com/apikey
set GEMINI_API_KEY=
rem Optional: override the model id (default: gemini-3-flash)
rem set GEMINI_MODEL=gemini-3-flash

rem -- Claude (optional) ---------------------------------------------------
rem Get a key at https://console.anthropic.com/
rem set LLM_PROVIDER=anthropic
rem set ANTHROPIC_API_KEY=
rem Optional: override the model id (default: claude-sonnet-4-6)
rem set ANTHROPIC_MODEL=claude-sonnet-4-6
